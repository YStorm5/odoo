<?xml version="1.0" ?>
<odoo>
    <record id="inherited_pos_order_view_form" model="ir.ui.view">
        <field name="name">inherited.pos.order.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="replace">
                <field name="product_uom_effective_id" string="UoM" groups="uom.group_uom"/>
            </xpath>
            <!-- <xpath expr="//field[@name='full_product_name']" position="after">
                <field name="product_uom2_id" string="UoM" groups="uom.group_uom"/>
            </xpath> -->
        </field>
    </record>
</odoo>