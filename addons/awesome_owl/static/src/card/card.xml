<templates>
    <t t-name="awesome_owl.Card">
        <div class="card col-12">
            <div class="card-body d-flex justify-content-around">
                <h5 class="card-title">
                    <t t-out="estate.name"/>
                </h5>
                <button class="btn btn-sm btn-primary" t-on-click="onToggle">Toggle</button>
            </div>
            <div class="card-text d-flex justify-content-center" t-if="isOpen.value">
                <t t-out="estate.description"/>
                <!-- <t t-slot="default"/>
                    <t t-slot="title"/> -->
            </div>
        </div>
    </t>
</templates>